# Copy this file to .env and enter your own API credentials.
# Never commit .env or paste your real API keys into public repositories.

OPENROUTER_API_KEY=
# Task-based model routing with automatic fallback. Keep these IDs comma-separated.
OPENROUTER_MODELS=xingchen-agi/xing4.0-29b-a4b:free,recursive/flint-v1.0:free,nvidia/nemotron-3.5-super-vl:free,liquid/lfm-2.5-2.6b:free

FISH_API_KEY=
FISH_VOICE_ID=41f0953d7a6b4c078445c7e65d620eeb
FISH_MODEL=s2.1-pro-free

# The key combination must be held while speaking.
# Releasing it sends the recording to speech recognition and the AI.
JARVIS_HOTKEY=ctrl+shift+space

# Local always-on wake word detection. Set to 0 to disable.
JARVIS_WAKE_WORD_ENABLED=1

# How JARVIS addresses you.
JARVIS_CALLS_YOU=sir

# SpeechRecognition language code, for example en-US.
JARVIS_SPEECH_LANGUAGE=en-US

# Fish Audio playback controls: volume 0.0-1.0, speed 0.5-2.0.
JARVIS_VOICE_VOLUME=0.85
JARVIS_VOICE_SPEED=1.0
